\@writefile{toc}{\contentsline {paragraph}{Bar-chart interpretation.}{21}{section*.18}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces \textbf  {GPT-4o-mini — mean cosine similarity by country.} Bars show means across eight topics; whiskers show \textbf  {standard deviation across topics} (topic dispersion). NvA and NvR are uniformly high (language and role remain close to native), while RvA is lower and more topic-sensitive (persona effect).}}{22}{figure.caption.19}\protected@file@percent }
\newlabel{fig:gpt_bars}{{4.9}{22}{\textbf {GPT-4o-mini — mean cosine similarity by country.} Bars show means across eight topics; whiskers show \textbf {standard deviation across topics} (topic dispersion). NvA and NvR are uniformly high (language and role remain close to native), while RvA is lower and more topic-sensitive (persona effect)}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {paragraph}{Heatmap observations.}{22}{section*.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces \textbf  {GPT-4o-mini — country–topic heatmaps.} Darker cells indicate higher similarity. Most-stable topics (darker across countries) include \emph  {Multi-party system} and \emph  {Adopt atheism}. The lowest rows in RvA (lighter cells) frequently occur on \emph  {No economic sanctions}, \emph  {Compulsory voting}, and \emph  {Adopt libertarianism}, revealing where persona prompts diverge most from the assistant baseline.}}{23}{figure.caption.21}\protected@file@percent }
\newlabel{fig:gpt_heat}{{4.10}{23}{\textbf {GPT-4o-mini — country–topic heatmaps.} Darker cells indicate higher similarity. Most-stable topics (darker across countries) include \emph {Multi-party system} and \emph {Adopt atheism}. The lowest rows in RvA (lighter cells) frequently occur on \emph {No economic sanctions}, \emph {Compulsory voting}, and \emph {Adopt libertarianism}, revealing where persona prompts diverge most from the assistant baseline}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.2}LLaMA~3.1-70B}{24}{subsection.4.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Bar-chart interpretation.}{24}{section*.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces \textbf  {LLaMA~3.1-70B — mean cosine similarity by country.} Bars are means across eight topics; whiskers show \textbf  {standard deviation across topics}. NvA and NvR remain uniformly high; RvA is lowest with larger topic dispersion, indicating a strong persona effect.}}{24}{figure.caption.23}\protected@file@percent }
\newlabel{fig:llama_bars}{{4.11}{24}{\textbf {LLaMA~3.1-70B — mean cosine similarity by country.} Bars are means across eight topics; whiskers show \textbf {standard deviation across topics}. NvA and NvR remain uniformly high; RvA is lowest with larger topic dispersion, indicating a strong persona effect}{figure.caption.23}{}}
\@writefile{toc}{\contentsline {paragraph}{Heatmap observations.}{24}{section*.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.12}{\ignorespaces \textbf  {LLaMA~3.1-70B — country–topic heatmaps.} Darker = higher similarity. As with GPT-4o-mini, \emph  {Multi-party system} and \emph  {Adopt atheism} are relatively stable/high across countries in NvA/NvR, whereas RvA is lighter on \emph  {No economic sanctions}, \emph  {Compulsory voting}, and \emph  {Adopt libertarianism}, indicating stronger persona-driven divergence.}}{26}{figure.caption.25}\protected@file@percent }
\newlabel{fig:llama_heat}{{4.12}{26}{\textbf {LLaMA~3.1-70B — country–topic heatmaps.} Darker = higher similarity. As with GPT-4o-mini, \emph {Multi-party system} and \emph {Adopt atheism} are relatively stable/high across countries in NvA/NvR, whereas RvA is lighter on \emph {No economic sanctions}, \emph {Compulsory voting}, and \emph {Adopt libertarianism}, indicating stronger persona-driven divergence}{figure.caption.25}{}}
