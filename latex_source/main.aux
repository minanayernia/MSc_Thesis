\newlabel{fig:pipeline_prompting}{{3.1a}{8}{Prompting setup. For each argument, we query three conditions: \emph {Role} (country persona), \emph {Assistant} (default), and \emph {Native} (prompt in the country’s language). Each reply is normalized to JSON with \texttt {idea} (stance) and \texttt {reason} (justification)}{figure.caption.3}{}}
\newlabel{sub@fig:pipeline_prompting}{{a}{8}{Prompting setup. For each argument, we query three conditions: \emph {Role} (country persona), \emph {Assistant} (default), and \emph {Native} (prompt in the country’s language). Each reply is normalized to JSON with \texttt {idea} (stance) and \texttt {reason} (justification)}{figure.caption.3}{}}
\newlabel{fig:pipeline_analysis}{{3.1b}{8}{Analysis paths. (i) \textbf {Agreement Ratio}: stance agreement with the gold conclusion stance. (ii) \textbf {Embedding Similarity}: double-translate reasons to align languages, embed, then compute cosine similarity}{figure.caption.3}{}}
\newlabel{sub@fig:pipeline_analysis}{{b}{8}{Analysis paths. (i) \textbf {Agreement Ratio}: stance agreement with the gold conclusion stance. (ii) \textbf {Embedding Similarity}: double-translate reasons to align languages, embed, then compute cosine similarity}{figure.caption.3}{}}
