\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces \textbf  {GPT-4o-mini — country–topic heatmaps.} Darker cells indicate higher similarity. Most-stable topics (darker across countries) include \emph  {Multi-party system} and \emph  {Adopt atheism}. The lowest rows in RvA (lighter cells) frequently occur on \emph  {No economic sanctions}, \emph  {Compulsory voting}, and \emph  {Adopt libertarianism}, revealing where persona prompts diverge most from the assistant baseline.}}{22}{figure.caption.22}\protected@file@percent }
\newlabel{fig:gpt_heat}{{4.11}{22}{\textbf {GPT-4o-mini — country–topic heatmaps.} Darker cells indicate higher similarity. Most-stable topics (darker across countries) include \emph {Multi-party system} and \emph {Adopt atheism}. The lowest rows in RvA (lighter cells) frequently occur on \emph {No economic sanctions}, \emph {Compulsory voting}, and \emph {Adopt libertarianism}, revealing where persona prompts diverge most from the assistant baseline}{figure.caption.22}{}}
